-- hw2_ts.smv : the transition system of Question 4
MODULE main
VAR
  st : {t0, t1, t2, t3, t4, t5, t6};

ASSIGN
  init(st) := t0;
  next(st) := case
    st = t0 : {t1, t2};
    st = t1 : {t3, t4};
    st = t2 : {t2, t5};
    st = t3 : t6;
    st = t4 : {t0, t4};
    st = t5 : t5;
    TRUE    : t3;          -- st = t6
  esac;

DEFINE
  p := st in {t0, t1, t2, t4};
  q := st in {t3, t5};
  r := st in {t2, t5, t6};

CTLSPEC EX r
CTLSPEC E [ p U q ]
CTLSPEC EG p
CTLSPEC A [ p U q ]
CTLSPEC AF q
CTLSPEC AG EF q
-- Part (c)
CTLSPEC AG (st = t6 -> AF q)
CTLSPEC AG (st = t4 -> AF q)
